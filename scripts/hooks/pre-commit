#!/bin/sh
# Pre-commit hook: gitleaks, lint staged files, type-check, uptake-lint, full test suite.
#
# Gated only on the core branches (integration/staging/main). Feature/worktree
# branches commit freely — their work is gated when the squashed chunk lands on
# integration. Detached HEAD (rebase machinery) is also ungated.

BRANCH=$(git symbolic-ref --quiet --short HEAD)
case "$BRANCH" in
    integration|staging|main) ;;
    *)
        echo "pre-commit: branch '${BRANCH:-detached HEAD}' is not a core branch — skipping gates."
        exit 0
        ;;
esac

# Gitleaks: scan staged diff for secrets BEFORE any other gate — before the
# staged-py short-circuit so non-Python secrets (YAML keys, .env files) are caught.
bash scripts/gates/gitleaks.sh staged || { echo "pre-commit: gitleaks found a secret in the staged diff — remove it (or allowlist a PROVEN fake in .gitleaks.toml)"; exit 1; }

RUFF=".venv/bin/ruff"
MYPY=".venv/bin/mypy"
UPTAKE_LINT=".venv/bin/uptake-lint"
PYTEST=".venv/bin/pytest"

# Check if any Python files are staged
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ -z "$STAGED_PY" ]; then
    exit 0
fi

# Fail closed: every tool must be present in a provisioned tree.
for _tool in "$RUFF" "$MYPY" "$UPTAKE_LINT" "$PYTEST"; do
    if [ ! -x "$_tool" ]; then
        echo "pre-commit: $_tool not found — gate from a provisioned tree (~/opsalert-landing)"
        exit 1
    fi
done

# Step 0: ruff on staged files
echo "pre-commit: running ruff on staged files..."
if ! echo "$STAGED_PY" | xargs "$RUFF" check; then
    echo ""
    echo "pre-commit: ruff found issues. Fix (ruff check --fix) or use --no-verify to skip."
    exit 1
fi

# Step 1: mypy type check (opsalert/ package)
echo "pre-commit: running mypy..."
$MYPY opsalert/ --incremental
MYPY_STATUS=$?
if [ $MYPY_STATUS -ne 0 ]; then
    echo ""
    echo "pre-commit: mypy found type errors. Fix them or use --no-verify to skip."
    exit $MYPY_STATUS
fi

# Step 2: uptake-lint on staged files
echo "pre-commit: running uptake-lint..."
$UPTAKE_LINT --staged
LINT_STATUS=$?
if [ $LINT_STATUS -ne 0 ]; then
    echo ""
    echo "pre-commit: uptake-lint found blocking issues. Fix them or use --no-verify to skip."
    exit $LINT_STATUS
fi

# Step 3: full test suite (~50s; no -x)
echo "pre-commit: running pytest..."
$PYTEST tests/ -q -p no:cacheprovider
TEST_STATUS=$?
if [ $TEST_STATUS -ne 0 ]; then
    echo ""
    echo "pre-commit: tests failed. Fix them or use --no-verify to skip."
    exit $TEST_STATUS
fi

exit 0
